# Spotify Developer App credentials
# Get from https://developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Neon Postgres connection string (optional)
# If unset, the app still works — cache layer fails open, every request hits
# Spotify/iTunes/LRCLIB directly. Get from https://console.neon.tech →
# your project → Connection Details → use the "Pooled connection" variant.
DATABASE_URL=

# Salt for hashing visitor IPs (optional)
# If unset, page views are still counted, but unique-visitor dedup is skipped.
# Generate a random 32-char string and keep it secret. Changing this resets
# UV counts for the current day.
IP_SALT=

# Auth token for /api/cron/refresh — Vercel Cron sends this as
# Authorization: Bearer <CRON_SECRET>. Generate any long random string.
# If unset, cron requests will be rejected with 500.
CRON_SECRET=

# OpenRouter API key — powers the "SongDNA" feature (歌曲背后的故事 AI 随笔).
# Get one at https://openrouter.ai/keys.
# If unset, the SongDNA button returns a 500 and other features still work.
OPENROUTER_API_KEY=

# Model override. Default is deepseek/deepseek-chat (cheap, great at Chinese,
# no region lock). When deployed to Vercel (US IP), free to switch to
# anthropic/claude-sonnet-4.6 for higher quality.
OPENROUTER_MODEL=
